# Magnet OS — environment variables. Copy to .env and fill in.
# .env and /backups are gitignored. NEVER commit real keys.
# The service_role key and Resend key are SERVER-SIDE ONLY — never put them in
# index.html or any browser code.

# ---------------------------------------------------------------------------
# Supabase (production project = jdylrthffifbhyrrhuqd)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://jdylrthffifbhyrrhuqd.supabase.co

# Publishable/anon key — this one is PUBLIC (already shipped in index.html). Used
# by the backup tool as a fallback read key. Reads only what anon RLS allows.
SUPABASE_ANON_KEY=sb_publishable_6Qe2KdPIZ13Ij2wvkS12rA_k2ytZQLz

# Service-role key — SECRET. Bypasses RLS: needed to back up _accounts and to run
# restores. Get it from Supabase -> Project Settings -> API -> service_role.
# Used by tools/*.js and set as a secret on the accounts Edge Function.
SUPABASE_SERVICE_ROLE_KEY=

# The public intake function (api/intake.js / netlify) reads SUPABASE_KEY; set it
# to the service_role key in the host's env for hardened writes.
SUPABASE_KEY=

# ---------------------------------------------------------------------------
# Email (Resend) — used by api/send-email.js, netlify send-email, and the
# accounts Edge Function's forgot-password flow.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Until you verify a domain in Resend, use the shared sender:
FROM_EMAIL=Magnet OS <onboarding@resend.dev>

# Public-form alert recipients (optional, used by intake functions)
HR_EMAIL=
SALES_EMAIL=

# ---------------------------------------------------------------------------
# Auth safety flags
# ---------------------------------------------------------------------------
# Allow the browser-side legacy/anon login fallback (used only when the accounts
# Edge Function is unreachable). Default OFF in production. Set to true ONLY for
# local development against an open (non-locked-down) database.
MAGNET_ALLOW_DEV_AUTH_FALLBACK=false

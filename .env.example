# Magnet OS — environment variables. Copy to .env and fill in.
# .env and /backups are gitignored. NEVER commit real keys.
# The service_role key and Resend key are SERVER-SIDE ONLY — never put them in
# index.html or any browser code.

# ---------------------------------------------------------------------------
# Supabase — always set the exact deployment target. The V2 Production project
# is intentionally not used as a code fallback, so stale tools cannot reach the
# retired 402 database or a future Staging database by accident.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<production-project-ref>.supabase.co
MAGNET_STAGING_PROJECT_REF=

# Publishable/anon key — public by design and limited by RLS. It is used by the
# browser/config check, never as a full-backup credential.
SUPABASE_ANON_KEY=

# Service-role key — SECRET. Bypasses RLS: needed to back up _accounts and to run
# restores. Get it from Supabase -> Project Settings -> API -> service_role.
# Used by tools/*.js and set as a secret on the accounts Edge Function.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy compatibility key used by older tooling. Keep this publishable/anon;
# api/intake.js and api/public-form.js require SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_KEY=

# Server-side public forms resolve one explicit organization by this slug before
# every read/write. Use a deployment-scoped value; never infer a tenant from email.
SUPABASE_ORGANIZATION_SLUG=magnet

# ---------------------------------------------------------------------------
# Email (Resend) — provider delivery runs only through the durable server outbox
# and the accounts Edge Function's recovery flow.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Until you verify a domain in Resend, use the shared sender:
FROM_EMAIL=Magnet OS <onboarding@resend.dev>

# Restrict browser calls to the email endpoint. The live Magnet origin is
# allowed by default; add a custom domain or local preview only when needed.
EMAIL_ALLOWED_ORIGINS=
# Shared only by trusted server-side callers (for example the accounts Edge
# Function -> Vercel email fallback). Use a long random value and set the same
# value in both hosting environments. Never put it in browser code.
EMAIL_SHARED_SECRET=

# Protects automatic/manual outbox workers. Use a separate random value; never
# expose it to the browser. CRON_SECRET is accepted as a deployment alternative.
OUTBOX_WORKER_SECRET=
CRON_SECRET=

# Public-form alert recipients (optional, used by intake functions)
HR_EMAIL=
SALES_EMAIL=

# Public website form boundary and one-way anti-abuse fingerprinting.
MAGNET_FORM_ALLOWED_ORIGINS=
PUBLIC_INTAKE_SHARED_SECRET=
PUBLIC_INTAKE_FINGERPRINT_SECRET=
MAGNET_APP_URL=https://magnet-os-staging.vercel.app

# Optional WhatsApp provider abstraction. Meta is the first supported adapter;
# leaving these blank records CONFIGURATION_MISSING instead of losing a message.
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
HR_WHATSAPP=
SALES_WHATSAPP=

# ---------------------------------------------------------------------------
# Initial owner setup
# ---------------------------------------------------------------------------
# Required by the Supabase accounts Edge Function before its first Owner can be
# created. Generate a long random value, set it as an Edge Function secret, and
# enter it once in the in-app first-owner setup screen. The browser never stores it.
INITIAL_OWNER_SETUP_SECRET=

# Optional now, required before commercial Auth rollout. A long random secret for
# legacy HMAC sessions, separate from service-role key rotation.
ACCOUNTS_SESSION_SECRET=

# Accounts Edge Function Auth cutover contract. Keep both false during the legacy
# cohort. Before private tenant RLS becomes mandatory, set ENABLED=true and
# REQUIRED=true so a missing database flag cannot silently downgrade users to anon.
# Optional roles are comma-separated; empty means every role.
AUTH_V2_ENABLED=false
AUTH_V2_REQUIRED=false
AUTH_V2_ROLES=
